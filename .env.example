# Supabase（Project Settings → API からコピー）
# ※ URL は Project URL だけ。末尾に /rest/v1 は付けない
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ローカル: このファイルを .env にコピーして値を入れる
# cp .env.example .env

# 期限切れ作品の自動削除スクリプト用（Git にコミットしない）
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
